 << /S/JavaScript/JS(function groupEval(doc,qtfield,probno,aKey,aWeights){    var totalGrpPts = aWeights[0];    var totalWeight = aWeights[1];    for ( var i=1,total=0; i< aKey.length; i++ )        if (aKey[i] != undefined) total += aKey[i]*aWeights[i+1];    return total;}function WeightedEval(doc,qtfield,probno,aKey,aWeights){    var f = doc.getField("grpobj." + qtfield + "." + probno);    var nGrpQno = f.getArray().length;    var totalGrpPts = aWeights[0];    var totalWeight = aWeights[1];    for ( var i=1,total=0; i < aKey.length; i++ )        if (aKey[i] != undefined) total += aKey[i]*aWeights[i+1];    total /= totalWeight;    total = Math.floor( total * totalGrpPts );    return total;}function groupBernoulliEval(doc,qtfield,probno,aKey,aWeights){    var f = doc.getField("grpobj." + qtfield + "." + probno);    var nGrpQno = f.getArray().length;    var totalGrpPts = aWeights[0];    for ( var i=1,isCorrect=1; i<= nGrpQno; i++ )        isCorrect *= (aKey[i] != undefined) ? (Number(aKey[i])) : 0;    return (isCorrect*totalGrpPts);}) >> 
